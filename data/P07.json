{
  "lesson": "P07",
  "goal": "Hear the puff of air in all six pairs (b/p, d/t, g/k, z/c, zh/ch, j/q) in a random mix, alone and in a row, with all four tones.",
  "items": [],
  "steps": [
    {"type": "intro", "title": "Recap: the puff of air",
     "text": "No new sounds today. You've met six pairs that differ only in a **puff of air**: the second of each pair has one, the first doesn't.\n\nHand in front of your mouth: b d g z zh j stay still, p t k c ch q blow. This lesson mixes them all up, in all four tones.",
     "rows": [["s-bo1", "s-po1"], ["s-de4", "s-te4"], ["s-ge1", "s-ke1"], ["s-ze4", "s-ce4"], ["s-zhe1", "s-che1"], ["s-ji1", "s-qi1"]]},
    {"type": "hear", "play": "s-po4", "options": ["bò", "pò"]},
    {"type": "hear", "play": "s-de2", "options": ["dé", "té"]},
    {"type": "hear", "play": "s-ke3", "options": ["gě", "kě"]},
    {"type": "hear", "play": "s-ce4", "options": ["zè", "cè"]},
    {"type": "hear", "play": "s-zhe2", "options": ["zhé", "ché"]},
    {"type": "hear", "play": "s-qi1", "options": ["jī", "qī"]},

    {"type": "chart", "title": "Puff or no puff",
     "text": "Three pairs in all four tones: without a puff, then with one.",
     "syllables": ["ge", "ke", "ze", "ce", "ji", "qi"], "tones": [1, 2, 3, 4]},
    {"type": "same", "pair": ["s-te1", "s-de1"]},
    {"type": "same", "pair": ["s-qi4", "s-qi4"]},
    {"type": "same", "pair": ["s-zhe4", "s-che4"]},
    {"type": "same", "pair": ["s-bo2", "s-po2"]},
    {"type": "same", "pair": ["s-ke2", "s-ke2"]},
    {"type": "audio", "item": "s-te2", "options": ["s-de2", "s-te2", "s-ce2"]},
    {"type": "audio", "item": "s-ji4", "options": ["s-ji4", "s-qi4", "s-zhe4"]},
    {"type": "hear", "play": "s-che3", "options": ["zhě", "chě", "zě", "cě"]},
    {"type": "hear", "play": "s-bo4", "options": ["bò", "pò", "mò", "fò"]},

    {"type": "intro", "title": "Puff and tone together",
     "text": "Now both at once: which initial, and which tone? Take your time: listen to the start for the puff, then to the pitch.",
     "rows": [["s-ge1", "s-ke2", "s-ge3", "s-ke4"], ["s-ji1", "s-qi2", "s-ji3", "s-qi4"]]},
    {"type": "tone", "play": "s-po3", "options": [1, 2, 3, 4]},
    {"type": "tone", "play": "s-te1", "options": [1, 2, 3, 4]},
    {"type": "tone", "play": "s-ce2", "options": [1, 2, 3, 4]},
    {"type": "tone", "play": "s-ji4", "options": [1, 2, 3, 4]},
    {"type": "match", "mode": "sound", "items": ["s-bo1", "s-te2", "s-ke3", "s-ce4"]},
    {"type": "match", "mode": "sound", "items": ["s-po1", "s-zhe2", "s-qi3", "s-de4"]},
    {"type": "type", "item": "s-ke4", "from": "audio"},
    {"type": "type", "item": "s-qi2", "from": "audio"},

{"type": "intro", "title": "Puff in a row",
     "text": "Now pairs and threes in a row, puff and no puff mixed, in all four tones. Listen to the start of each sound for the puff, then to its pitch.\n\nPlay each row with ▶.",
     "rows": [["s-bo1", "s-po1", "s-bo4"], ["s-te2", "s-de2", "s-te3"], ["s-ke1", "s-ge3", "s-ke4"]]},
    {"type": "odd", "play": "s-de4", "odd": "s-te4"},
    {"type": "odd", "play": "s-qi2", "odd": "s-ji2"},
    {"type": "order", "sounds": ["s-ke3", "s-le4"], "options": ["kě lè", "gě lè", "kè lě", "kě nè"]},
    {"type": "order", "sounds": ["s-ke4", "s-qi1"], "options": ["kè qī", "gè qī", "kè jī", "kě qī"]},
    {"type": "order", "sounds": ["s-po1", "s-te2", "s-ke3"], "options": ["pō té kě", "bō dé gě", "pō dé kě", "pō té kè"]},
    {"type": "odd", "play": "s-zhe3", "odd": "s-che3"},
    {"type": "hear", "play": "s-ce3", "options": ["zě", "cě", "zhě", "chě"]},
    {"type": "same", "pair": ["s-po3", "s-po4"]},
    {"type": "order", "sounds": ["s-ji4", "s-de3"], "options": ["jì dě", "qì dě", "jì tě", "jǐ dè"]},
    {"type": "match", "mode": "sound", "items": ["s-ge1", "s-ce2", "s-bo3", "s-te4"]},
    {"type": "type", "item": "s-te4", "from": "audio"}
  ]
}
