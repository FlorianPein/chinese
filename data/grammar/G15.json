 "blocks": [
  {"text": "也 (yě, *also, too*) and 都 (dōu, *all, both*) go right **before the verb** or adjective. Never at the start or the end of the sentence."},
  {"h": "也: also, too, either"},
  {"pattern": "A + 也 + verb", "english": "A also …"},
  {"ex": [
   ["我[也]是学生。", "Wǒ [yě] shì xuésheng.", "I'm a student too."],
   ["我[也]很忙。", "Wǒ [yě] hěn máng.", "I'm busy too."],
   ["我[也]想去。", "Wǒ [yě] xiǎng qù.", "I want to go too."],
   ["他[也]不知道。", "Tā [yě] bù zhīdào.", "He doesn't know either.", "也不 = not either."]
  ]},
  {"wrong": [
   ["也我是学生。", "Yě wǒ shì xuésheng.", "也 goes after the person, before the verb: 我也是学生."],
   ["我是学生也。", "Wǒ shì xuésheng yě.", "Not at the end either: 我也是学生."]
  ]},
  {"h": "都: all, both"},
  {"text": "都 sums up the people or things **before** it: 我们都 *all of us*, 他们都 *all of them*."},
  {"pattern": "A + 都 + verb", "english": "all of A …"},
