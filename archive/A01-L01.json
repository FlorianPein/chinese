{
  "lesson": "A01-L01",
  "title": "High and falling: tones 1 and 4",
  "goal": "Hear and say the 1st tone (high) and the 4th tone (falling), and use your first 5 words.",
  "items": [
    {"id": "ta", "kind": "word", "pinyin": "tā", "english": "he / she", "hanzi": "他 / 她", "note": "One word for both he and she. Only the characters are different."},
    {"id": "he", "kind": "word", "pinyin": "hē", "english": "to drink", "hanzi": "喝", "note": "The h is rough, like German ch in Bach, not a soft English h."},
    {"id": "shi", "kind": "word", "pinyin": "shì", "english": "to be (am / is / are)", "hanzi": "是", "note": "Same form for I am, you are, she is. Chinese verbs never change."},
    {"id": "bu", "kind": "word", "pinyin": "bù", "english": "not, no", "hanzi": "不", "note": "Goes right before the verb: bù hē = don't drink."},
    {"id": "dui", "kind": "word", "pinyin": "duì", "english": "right, correct", "hanzi": "对", "note": "Duì! on its own means Right! / Exactly!"},
    {"id": "ta-he", "kind": "phrase", "pinyin": "Tā hē.", "english": "He / she drinks.", "literal": "he / drink", "hanzi": "他喝。"},
    {"id": "ta-bu-he", "kind": "phrase", "pinyin": "Tā bù hē.", "english": "He / she doesn't drink.", "literal": "he / not / drink", "hanzi": "他不喝。"},
    {"id": "dui-shi-ta", "kind": "phrase", "pinyin": "Duì, shì tā!", "english": "Right, it's him / her!", "literal": "right / is / him", "hanzi": "对，是他！"}
  ],
  "sounds": {
    "s-ma1": "mum", "s-ma2": "hemp", "s-ma3": "horse", "s-ma4": "to scold", "s-ma5": "question word"
  },
  "steps": [
    {"type": "intro", "title": "Every syllable has a tone",
     "text": "A tone is a pitch shape: high, rising, low or falling. It's part of the word, like its vowels. Change the tone and you get a different word.\n\nTap each one and listen. It's the same syllable **ma**, five times:",
     "rows": [["s-ma1", "s-ma2", "s-ma3", "s-ma4", "s-ma5"]]},
    {"type": "intro", "tone": 1, "title": "1st tone: high and flat",
     "text": "Start high and hold it, like singing one note.\n\nEnglish: the *Aaah* at the doctor's. German: a sung *Laaa*.\n\nThe mark is a flat line: **ā**.",
     "rows": [["s-ma1", "s-ta1", "s-he1", "s-shi1"]]},
    {"type": "intro", "tone": 4, "title": "4th tone: a sharp fall",
     "text": "Start high and drop fast, like a firm *No!* or *Stop!* German: *Nein!* or *Doch!*\n\nThe mark falls from left to right: **à**.",
     "rows": [["s-ma4", "s-ta4", "s-shi4", "s-bu4"]]},
    {"type": "intro", "title": "High or falling?",
     "text": "Each pair is the same syllable, first in the 1st tone, then in the 4th. Play each pair a few times.",
     "rows": [["s-ma1", "s-ma4"], ["s-ta1", "s-ta4"], ["s-he1", "s-he4"], ["s-shi1", "s-shi4"]]},
    {"type": "tone", "play": "s-ma1", "options": [1, 4]},
    {"type": "tone", "play": "s-ma4", "options": [1, 4]},
    {"type": "hear", "play": "s-ta4", "options": ["tā", "tà"]},
    {"type": "hear", "play": "s-he1", "options": ["hē", "hè"]},
    {"type": "tone", "play": "s-shi4", "options": [1, 4]},
    {"type": "tone", "play": "s-bu1", "options": [1, 4]},
    {"type": "hear", "play": "s-shi1", "options": ["shī", "shì"]},
    {"type": "tone", "play": "s-ta1", "options": [1, 4]},

    {"type": "new", "item": "ta"},
    {"type": "hear", "play": "ta", "options": ["tā", "tà"]},
    {"type": "new", "item": "he"},
    {"type": "meaning", "item": "he", "from": "audio", "options": ["ta", "he"]},
    {"type": "meaning", "item": "ta", "from": "pinyin", "options": ["ta", "he"]},
    {"type": "new", "item": "shi"},
    {"type": "pinyin", "item": "shi", "options": ["shì", "shī"]},
    {"type": "tone", "play": "shi", "options": [1, 4]},
    {"type": "new", "item": "bu"},
    {"type": "meaning", "item": "bu", "from": "audio", "options": ["bu", "shi", "he"]},
    {"type": "match", "items": ["ta", "he", "shi", "bu"]},
    {"type": "new", "item": "dui"},
    {"type": "tone", "play": "dui", "options": [1, 4]},
    {"type": "meaning", "item": "dui", "from": "pinyin", "options": ["dui", "bu", "shi"]},
    {"type": "type", "item": "he", "from": "english"},
    {"type": "type", "item": "bu", "from": "english"},

    {"type": "intro", "title": "Your first sentences",
     "text": "Chinese word order is like English: **he / drinks**. To say *not*, put **bù** right before the verb: **he / not / drinks**."},
    {"type": "new", "item": "ta-he"},
    {"type": "new", "item": "ta-bu-he"},
    {"type": "meaning", "item": "ta-bu-he", "from": "audio", "options": ["ta-he", "ta-bu-he"]},
    {"type": "build", "item": "ta-bu-he", "extra": ["shì"]},
    {"type": "hear", "play": "ta-he", "options": ["Tā hē.", "Tà hē.", "Tā hè."]},
    {"type": "new", "item": "dui-shi-ta"},
    {"type": "meaning", "item": "dui-shi-ta", "from": "audio", "options": ["dui-shi-ta", "ta-bu-he", "ta-he"]},
    {"type": "build", "item": "dui-shi-ta", "extra": ["bù"]},

    {"type": "tone", "play": "s-he4", "options": [1, 4]},
    {"type": "type", "item": "shi", "from": "audio"},
    {"type": "type", "item": "ta", "from": "audio"},
    {"type": "match", "items": ["dui", "ta-he", "ta-bu-he", "shi"]},
    {"type": "pinyin", "item": "dui", "options": ["duì", "duī"]},
    {"type": "hear", "play": "s-bu4", "options": ["bū", "bù"]},
    {"type": "type", "item": "ta-bu-he", "from": "english"},

    {"type": "speak", "item": "ta-bu-he"},
    {"type": "speak", "item": "dui-shi-ta"}
  ]
}
