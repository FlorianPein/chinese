{
  "lesson": "A01-L02",
  "title": "Low: tone 3",
  "goal": "Hear and say the 3rd tone (low) next to tones 1 and 4, and say I, you and OK.",
  "items": [
    {"id": "wo", "kind": "word", "pinyin": "wǒ", "english": "I, me", "hanzi": "我", "note": "Like English woe, but low. I and me are the same word."},
    {"id": "ni", "kind": "word", "pinyin": "nǐ", "english": "you", "hanzi": "你", "note": "Like English knee, but low."},
    {"id": "hao", "kind": "word", "pinyin": "hǎo", "english": "good; OK", "hanzi": "好", "note": "Hǎo! on its own means OK! / Fine! The ao sounds like English how (with a rough German h)."},
    {"id": "wo-bu-he", "kind": "phrase", "pinyin": "Wǒ bù hē.", "english": "I don't drink. / I won't have any.", "literal": "I / not / drink", "hanzi": "我不喝。"},
    {"id": "shi-wo", "kind": "phrase", "pinyin": "Shì wǒ.", "english": "It's me.", "literal": "is / me", "hanzi": "是我。"},
    {"id": "hao-wo-he", "kind": "phrase", "pinyin": "Hǎo, wǒ hē.", "english": "OK, I'll drink (some).", "literal": "OK / I / drink", "hanzi": "好，我喝。"}
  ],
  "steps": [
    {"type": "intro", "title": "Warm-up",
     "text": "First a few things from last time: the 1st tone (high, flat) and the 4th tone (falling).",
     "rows": [["s-ma1", "s-ma4"]]},
    {"type": "tone", "play": "s-ta4", "options": [1, 4]},
    {"type": "meaning", "item": "he", "from": "audio", "options": ["he", "ta", "bu"]},
    {"type": "build", "item": "ta-bu-he", "extra": ["duì"]},
    {"type": "type", "item": "shi", "from": "english"},
    {"type": "hear", "play": "dui", "options": ["duì", "duī"]},
    {"type": "match", "items": ["ta", "he", "shi", "bu", "dui"]},

    {"type": "intro", "tone": 3, "title": "3rd tone: low",
     "text": "Drop your voice low and keep it relaxed. A bit creaky is fine.\n\nEnglish: a low, doubtful *Hmm…* German: a reluctant *Na ja…*\n\nSaid on its own, it often rises a little at the end. Inside a sentence it mostly just stays **low**. Beginners make it too bouncy, so think *low*, not *down-up*.\n\nThe mark is a little valley: **ǎ**.",
     "rows": [["s-ma3", "s-wo3", "s-ni3", "s-hao3"]]},
    {"type": "intro", "title": "High, low or falling?",
     "text": "Here are the three tones you know now, on the same syllables. Play each row a few times and draw the shapes in the air with your hand.",
     "rows": [["s-ma1", "s-ma3", "s-ma4"], ["s-hao1", "s-hao3", "s-hao4"], ["s-ni1", "s-ni3", "s-ni4"]]},
    {"type": "tone", "play": "s-ma3", "options": [1, 3, 4]},
    {"type": "tone", "play": "s-hao3", "options": [1, 3, 4]},
    {"type": "hear", "play": "s-wo4", "options": ["wǒ", "wò"]},
    {"type": "tone", "play": "s-ni1", "options": [1, 3, 4]},
    {"type": "tone", "play": "s-bu3", "options": [1, 3, 4]},
    {"type": "hear", "play": "s-he3", "options": ["hē", "hě", "hè"]},

    {"type": "new", "item": "wo"},
    {"type": "hear", "play": "wo", "options": ["wǒ", "wō", "wò"]},
    {"type": "new", "item": "ni"},
    {"type": "meaning", "item": "ni", "from": "audio", "options": ["ni", "wo", "ta"]},
    {"type": "meaning", "item": "wo", "from": "pinyin", "options": ["wo", "ni", "ta"]},
    {"type": "match", "items": ["wo", "ni", "ta", "he"]},
    {"type": "new", "item": "hao"},
    {"type": "tone", "play": "hao", "options": [1, 3, 4]},
    {"type": "pinyin", "item": "hao", "options": ["hǎo", "hāo", "hào"]},
    {"type": "type", "item": "wo", "from": "english"},

    {"type": "intro", "title": "Coming soon: nǐ hǎo",
     "text": "You probably know **nǐ hǎo** (hello). It's two 3rd tones in a row, and that makes the first one change. That gets its own lesson, so for now we leave it out."},
    {"type": "new", "item": "wo-bu-he"},
    {"type": "meaning", "item": "wo-bu-he", "from": "audio", "options": ["wo-bu-he", "ta-bu-he", "ta-he"]},
    {"type": "build", "item": "wo-bu-he", "extra": ["nǐ"]},
    {"type": "new", "item": "shi-wo"},
    {"type": "hear", "play": "shi-wo", "options": ["Shì wǒ.", "Shì nǐ.", "Shì tā."]},
    {"type": "new", "item": "hao-wo-he"},
    {"type": "build", "item": "hao-wo-he", "extra": ["bù"]},
    {"type": "meaning", "item": "hao-wo-he", "from": "pinyin", "options": ["hao-wo-he", "wo-bu-he", "shi-wo"]},

    {"type": "tone", "play": "ni", "options": [1, 3, 4]},
    {"type": "tone", "play": "dui", "options": [1, 3, 4]},
    {"type": "tone", "play": "ta", "options": [1, 3, 4]},
    {"type": "type", "item": "wo", "from": "audio"},
    {"type": "type", "item": "ni", "from": "audio"},
    {"type": "type", "item": "ta-bu-he", "from": "english"},
    {"type": "match", "items": ["ni", "wo", "hao", "bu", "dui"]},
    {"type": "hear", "play": "dui-shi-ta", "options": ["Duì, shì tā!", "Duì, shì wǒ!", "Duì, shì nǐ!"]},
    {"type": "type", "item": "shi-wo", "from": "english"},

    {"type": "speak", "item": "hao-wo-he"},
    {"type": "speak", "item": "wo-bu-he"},
    {"type": "speak", "item": "shi-wo"}
  ]
}
